# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local. Never paste these values in chat or screenshots.

# Supabase → Connect → Framework (Next.js). Paste the two lines as Supabase shows them.
# (The older name NEXT_PUBLIC_SUPABASE_ANON_KEY also works.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_…). SERVER ONLY.
# Used only to sign file uploads and private download links. Never add NEXT_PUBLIC_ to it.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Supabase → Connect → ORM (Drizzle) → Transaction pooler (port 6543). Put your DB password in.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Public site URL (used in emails and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
